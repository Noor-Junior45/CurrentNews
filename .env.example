# =========================================================================
# Google Cloud Run Deployment & Environment Configuration
# =========================================================================

# Runtime host and port (Cloud Run injects PORT automatically, defaults to 8080)
PORT=8080

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The primary canonical URL where this applet is hosted.
APP_URL="https://www.currentnews.blog"

# =========================================================================
# Editorial Staff & Authorized Writers (Configurable via Environment Variable)
# =========================================================================
# Comma-separated list of author bylines and/or authorized writer email addresses.
# Any email address placed here (e.g., mdhassan1738@gmail.com, colleague@example.com)
# will automatically receive author and publishing privileges when signing in with Google.
VITE_WRITERS="Current News Staff Report,Investigative Editorial Bureau,Chief Political Correspondent,Technology & Science Desk,Global Affairs Dispatch,Chronicle Desk,mdhassan1738@gmail.com"


# =========================================================================
# Third-Party Infrastructure Services
# =========================================================================
# Resend Email Delivery
RESEND_API_KEY=""
RESEND_SENDER_EMAIL="alerts@currentnews.blog"
RESEND_SENDER_NAME="Current News"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="currentnews-media"
R2_ENDPOINT="https://d3dfb94681e636f340d88b37fd135cee.r2.cloudflarestorage.com"
R2_PUBLIC_DOMAIN="media.currentnews.blog"
R2_DEV_DOMAIN="pub-03dd1274c4824531a1478f20e0485d75.r2.dev"
