# Android Keystore Signing Configuration (Optional)
# If you want Gradle to automatically sign your APK / AAB during build:
# 1. Rename this file to "keystore.properties"
# 2. Fill in your release keystore details:

storeFile=currentnews-release-key.jks
storePassword=YourKeystorePasswordHere
keyAlias=currentnews
keyPassword=YourKeyPasswordHere
