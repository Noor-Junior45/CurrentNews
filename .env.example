# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google AdSense integration clients (Optional)
VITE_ADSENSE_CLIENT=""
VITE_ADSENSE_SLOT_LEADERBOARD=""
VITE_ADSENSE_SLOT_SIDEBAR=""
VITE_ADSENSE_SLOT_FOOTER=""

# Resend API configuration for automated email alerts
RESEND_API_KEY=""
RESEND_SENDER_EMAIL="alerts@currentnews.blog"
RESEND_SENDER_NAME="Current News"

# Cloudflare R2 Object Storage for photo uploads
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="currentnews-media"
R2_ENDPOINT="https://d3dfb94681e636f340d88b37fd135cee.r2.cloudflarestorage.com"
R2_PUBLIC_DOMAIN="media.currentnews.blog"
R2_DEV_DOMAIN="pub-03dd1274c4824531a1478f20e0485d75.r2.dev"



